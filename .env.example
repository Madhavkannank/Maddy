# M.A.D.D.Y. Environment Configuration Example
# Copy this file to .env and fill in your values: cp .env.example .env

# ==============================================================================
# 1. AI & LLM Inference APIs
# ==============================================================================
# Groq Cloud API Key (Powers Whisper Large v3 Turbo STT & fast inference)
# https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Fallback API Key (automatic failover if primary key is rate-limited)
GROQ_API_KEY_FALLBACK=gsk_your_fallback_key_here

# ==============================================================================
# 2. Audio & Neural Wake Word Detection
# ==============================================================================
# Optional wake word engine: OpenWakeWord with multi-variant phrases ("maddy", "hey maddy", etc.)
# Sensitivity threshold (0.0 to 1.0, recommended: 0.35 - 0.45)
WAKE_THRESHOLD=0.55

# Number of consecutive confirmation frames required before activation (default: 3)
WAKE_CONFIRMATION_FRAMES=3

# Microphone digital pre-amplification multiplier (1.0 = normal, 1.5 - 2.5 for distant mics)
MIC_GAIN=1.0

# Optional: Specific audio input device index (leave blank for default OS mic)
AUDIO_INPUT_DEVICE=

# ==============================================================================
# 3. Text-to-Speech (TTS) Voice Engine
# ==============================================================================
# TTS priority chain: ElevenLabs (optional) → Edge-TTS (cloud fallback) → F5-TTS (optional local backend)
# Cloud voice providers send synthesized text to their respective services. Use Edge-TTS
# or F5-TTS when you do not want to configure ElevenLabs.

# Edge-TTS fallback voices (used when F5-TTS is unavailable)
EDGE_TTS_VOICE_MALE=en-US-ChristopherNeural
EDGE_TTS_VOICE_FEMALE=en-US-JennyNeural

# ElevenLabs High-Fidelity Neural Voice Configuration (Optional, additional fallback)
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID_1=your_voice_id_1_here
ELEVENLABS_VOICE_ID_2=your_voice_id_2_here

# ==============================================================================
# 4. Media & Third-Party Integrations
# ==============================================================================
# Spotify Developer API Credentials
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_ACCESS_TOKEN=
